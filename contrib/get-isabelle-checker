!/usr/bin/env bash

set -e -o pipefail

# utility function to download a file
function download {
  if [ -x "$(command -v wget)" ]; then
    wget -c -O "$2" "$1"
  elif [ -x "$(command -v curl)" ]; then
    curl -L "$1" >"$2"
  else
    echo "Can't figure out how to download from web.  Please install wget or curl." >&2
    exit 1
  fi
}

CVC_DIR=$(dirname $(dirname "$0"))
mkdir -p $CVC_DIR/deps
pushd $CVC_DIR/deps

BASE_DIR=`pwd`
mkdir -p $BASE_DIR/tmp/

##### Isabelle
ISABELLE_DIR="$BASE_DIR/isabelle"
mkdir -p $ISABELLE_DIR

# download and unpack Isabelle
ISABELLE_VERSION="fb1ce1163e7b8351c6bbfa8363c64a634044b3fd"
download "https://github.com/m-fleury/isabelle-emacs/tree/$ISABELLE_VERSION" $BASE_DIR/tmp/

