#!/usr/bin/env bash

set -e -o pipefail

# utility function to download a file
function download {
  if [ -x "$(command -v wget)" ]; then
    wget -c -O "$2" "$1"
  elif [ -x "$(command -v curl)" ]; then
    curl -L "$1" >"$2"
  else
    echo "Can't figure out how to download from web.  Please install wget or curl." >&2
    exit 1
  fi
}

CVC_DIR=$(dirname $(dirname "$0"))
mkdir -p $CVC_DIR/deps
pushd $CVC_DIR/deps

BASE_DIR=`pwd`
mkdir -p $BASE_DIR/tmp/

##### Isabelle
ISABELLE_DIR="$BASE_DIR/isabelle"
mkdir -p $ISABELLE_DIR
ISABELLE_SETTINGS_DIR="$BASE_DIR/.isabelle"
mkdir -p $ISABELLE_SETTINGS_DIR

# Install dependencies
# Unfortunately running Isabelle with -Djava.awt.headles
# Should I use curl and then build with make? How do I know what is installed?
apt-get update && apt-get install -y fontconfig fonts-dejavu


# download and unpack Isabelle
download "https://github.com/cvc5/isabelle-integration-evaluation/releases/download/IsabelleBinary/Isabelle.tar.gz" $BASE_DIR/tmp/Isabelle.tar.gz
tar --strip 1 -xvf $BASE_DIR/tmp/Isabelle.tar.gz -C $ISABELLE_DIR
rm $BASE_DIR/tmp/Isabelle.tar.gz

# build Isabelle
export USER_HOME="$BASE_DIR/"
export ISABELLE_HOME="$ISABELLE_DIR"
#Not sure if this one is needed
export ISABELLE_HOME_USER="$ISABELLE_DIR"

$ISABELLE_DIR/bin/isabelle components -a

#This can take a while
$ISABELLE_DIR/bin/isabelle build Main

mkdir -p $BASE_DIR/bin


cat << EOF > $BASE_DIR/bin/cvc5-isabelle-check.sh
#!/usr/bin/env bash
echo "=== Generate proof: \$@"
echo "> \$2.alethe"
$BASE_DIR/bin/cvc5-alethe-proof.sh \$@ > \$2.alethe
echo "=== Check proof with Isabelle"
$BASE_DIR/bin/isabelle-check.sh \$2.alethe \$2
EOF
chmod +x $BASE_DIR/bin/cvc5-isabelle-check.sh

cat << EOF > $BASE_DIR/bin/cvc5-alethe-proof.sh
#!/usr/bin/env bash
# call cvc5 and remove the first line of the output (should be "unsat", "(", ")")
\$@ --dump-proofs --proof-format=alethe | tail -n +3 | head -n -1
EOF
chmod +x $BASE_DIR/bin/cvc5-alethe-proof.sh

cat << EOF > $BASE_DIR/bin/isabelle-check.sh
#!/usr/bin/env bash
$BASE_DIR/bin/isabelle check --allow-int-real-subtyping --expand-let-bindings --ignore-unknown-rules \$@ > isabelle.out
cat isabelle.out
rm isabelle.out
EOF
chmod +x $BASE_DIR/bin/isabelle-check.sh

echo ""
echo "========== How to use Isabelle =========="
echo "Generate an Alethe proof with cvc5 (for terms printed without sharing, use --dag-thresh=0):"
echo "  $CVC_DIR/deps/bin/cvc5-alethe-proof.sh cvc5 <input file> <options>"
echo "Check a proof:"
echo "  $CVC_DIR/deps/bin/isabelle-check.sh <proof file> <input file>"
echo "Run cvc5 and check the generated proof:"
echo "  $CVC_DIR/deps/bin/cvc5-isabelle-check.sh cvc5 <input file> <options>"

